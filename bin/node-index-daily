#!/usr/bin/env python3
"""每日维护流水线: ingest → scan → check → summarize → (SOP 层级摘要有写入时 build) → digest → render → snapshot。

某一步失败不会阻止后面的步骤(例如 summarize 因网络失败,仍然要 render 和 snapshot);
任何一步失败则整体退出码为 1。每步一行日志,结果写入状态文件。同一时间只允许一个实例运行。
digest 带 --if-due: 距上次成功运行不满 7 天时该步只记一行「未到期」(记录在 host/digest-state.json)。
由 launchd 调用时务必用带 PyYAML 的解释器,系统 python3 (3.9) 不行。
"""
import argparse
import fcntl
import hashlib
import json
import os
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

REPO = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(REPO / "src"))
from node_index.db import LEAD_DOCS  # noqa: E402
CLI = REPO / "bin" / "node-index"
STATE_DIR = Path("~/.local/share/node-index").expanduser()
STEP_TIMEOUT = 3600
PATH_GONE = "挂载路径不存在"


def now():
    return datetime.now().strftime("%Y-%m-%dT%H:%M:%S")


def log(msg):
    print(f"[{now()}] {msg}", flush=True)


def gate_fingerprint(paths):
    """多个闸门路径合成一个指纹。文件夹按 skills_fingerprint;文件 (如 shared/categories.yaml) 看修改时间与大小。"""
    h = hashlib.sha256()
    for path in paths:
        h.update(f"{path}\0".encode())
        if path.is_dir():
            h.update(skills_fingerprint(path).encode())
        else:
            st = os.stat(path)
            h.update(f"{st.st_mtime_ns}:{st.st_size}".encode())
        h.update(b"\n")
    return h.hexdigest()


def skills_fingerprint(directory):
    """目录下各 skill 文件夹的指纹: 文件夹名 + 说明文档 (SKILL.md 等) 的修改时间与大小。
    只看这些,是为了过滤掉该目录里无关的写入 (例如 skill-manager 自己的 .git 与 .skills-manager 元数据,
    它们会让递归的 WatchPaths 反复触发),同时仍能发现新增、删除、以及说明文档被更新。"""
    h = hashlib.sha256()
    for name in sorted(os.listdir(directory)):
        path = os.path.join(directory, name)
        if name.startswith(".") or not os.path.isdir(path):
            continue
        h.update(name.encode())
        for lead in LEAD_DOCS:
            try:
                st = os.stat(os.path.join(path, lead))
            except OSError:
                continue
            h.update(f"|{lead}:{st.st_mtime_ns}:{st.st_size}".encode())
        h.update(b"\n")
    return h.hexdigest()


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--depth", type=int, default=2, help="提示词文档里的树深度")
    ap.add_argument("--db")
    ap.add_argument("--scope")
    ap.add_argument("--env")
    ap.add_argument("--prompt-out")
    ap.add_argument("--snapshot-out")
    ap.add_argument("--state-dir", default=str(STATE_DIR))
    ap.add_argument("--gate", "--gate-dir", dest="gate", action="append", default=[],
                    help="闸门,可重复: 文件夹看其下 skill 文件夹名与说明文档,文件看修改时间与大小;相对路径以仓库为根。"
                         "相对上次成功运行都没有变化时静默退出 0。给事件触发 (WatchPaths) 用,过滤无关写入")
    ap.add_argument("--step-timeout", type=int, default=STEP_TIMEOUT)
    args = ap.parse_args(argv)

    state_dir = Path(args.state_dir).expanduser()
    state_dir.mkdir(parents=True, exist_ok=True)
    gate_file = gate_fp = None
    if args.gate:
        gates = sorted({(REPO / Path(g).expanduser()).resolve() for g in args.gate})
        try:
            gate_fp = gate_fingerprint(gates)
        except OSError as e:
            log(f"闸门路径无法读取: {e}")
            return 1
        key = "\n".join(map(str, gates)) if len(gates) > 1 else str(gates[0])
        gate_file = state_dir / f"gate-{hashlib.sha1(key.encode()).hexdigest()[:10]}.json"
        try:
            last_fp = json.loads(gate_file.read_text(encoding="utf-8"))["fingerprint"]
        except (OSError, ValueError, KeyError):
            last_fp = None
        if gate_fp == last_fp:
            return 0  # 没有 skill 变化: 静默退出,不写日志,不动任何文件

    lock = open(state_dir / "daily.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        log("已有另一个实例在运行,本次跳过")
        return 0

    common = []
    if args.db:
        common += ["--db", args.db]

    def step_cmd(name):
        if name == "scan":
            return ["scan"] + (["--scope", args.scope] if args.scope else [])
        if name == "check":
            return ["check"]
        if name == "ingest":
            return ["ingest-access"]
        if name == "summarize":
            return ["summarize", "--json"] + (["--env", args.env] if args.env else [])
        if name == "build":
            return ["build"]
        if name == "digest":
            return ["digest", "--if-due", "--json"] + (["--env", args.env] if args.env else [])
        if name == "render":
            return ["render", "--depth", str(args.depth)] + (["--out", args.prompt_out] if args.prompt_out else [])
        if name == "snapshot":
            return ["snapshot"] + (["--out", args.snapshot_out] if args.snapshot_out else [])
        raise ValueError(name)

    def run_step(name):
        cmd = [sys.executable, str(CLI), *step_cmd(name), *common]
        t = time.time()
        try:
            p = subprocess.run(cmd, cwd=REPO, capture_output=True, text=True, timeout=args.step_timeout)
            code, out, err = p.returncode, p.stdout, p.stderr
        except subprocess.TimeoutExpired:
            code, out, err = -1, "", f"超时 {args.step_timeout} 秒"
        return code, out, err, round(time.time() - t, 1)

    started = now()
    log("开始每日维护")
    if gate_file:
        log(f"触发原因: {', '.join(args.gate)} 有变化")
    results = []
    names = ["ingest", "scan", "check", "summarize", "digest", "render", "snapshot"]
    for name in names:
        code, out, err, dur = run_step(name)
        first = (out.strip().splitlines() or [""])[0]
        failed_nodes = 0
        sop_hier = []
        if name == "summarize" and code == 0:
            # summarize 单个节点失败时命令本身仍退出 0,必须读结果判断;
            # 路径已失效的节点由 check 步骤标记,不算 summarize 的失败,否则任务会永久变红
            try:
                r = json.loads(out)
                sop_hier = list(r.get("sop_hier") or [])
                real = [f for f in r.get("failed", []) if f.get("reason") != PATH_GONE]
                gone = len(r.get("failed", [])) - len(real)
                failed_nodes = len(real)
                first = (f"目标 {r['targets']},成功 {len(r['ok'])},失败 {failed_nodes}"
                         + (f",另有 {gone} 个因路径失效跳过" if gone else ""))
                if real:
                    err = "; ".join(f"{f['id']}: {f['reason'][:80]}" for f in real[:3])
            except (json.JSONDecodeError, KeyError) as e:
                code, err = -2, f"无法解析 summarize 输出: {e}"
        if name == "digest" and code == 0:
            # 同 summarize: 单个检查单位失败时命令仍退出 0
            try:
                r = json.loads(out)
                if r.get("skipped"):
                    first = f"未到期,上次 {r['last_run']},下次 {r['next_due']}"
                else:
                    failed_nodes = len(r["failed"])
                    first = (f"检查 {r['targets']},新建 Report {len(r['reports'])},"
                             f"已有未关闭 {len(r['duplicates'])},失败 {failed_nodes}")
                    if failed_nodes:
                        err = "; ".join(f"{f['key']}: {f['reason'][:80]}" for f in r["failed"][:3])
            except (json.JSONDecodeError, KeyError) as e:
                code, err = -2, f"无法解析 digest 输出: {e}"
        ok_step = code == 0 and failed_nodes == 0
        log(f"{name}: {'ok' if ok_step else '失败'}{'' if code == 0 else '(exit=%d)' % code} {dur}s  {first}")
        if not ok_step and err.strip():
            log(f"  {name} 错误: {err.strip().splitlines()[-1][:300]}")
        results.append({"step": name, "exit": code if ok_step or code != 0 else 1, "seconds": dur,
                        "summary": first[:200], "failed_nodes": failed_nodes,
                        "error": err.strip().splitlines()[-1][:300] if not ok_step and err.strip() else None})
        if sop_hier:
            bcode, bout, berr, bdur = run_step("build")
            bfirst = (bout.strip().splitlines() or [""])[0]
            bok = bcode == 0
            log(f"build: {'ok' if bok else '失败'}{'' if bcode == 0 else '(exit=%d)' % bcode} {bdur}s  "
                f"SOP 层级摘要 {len(sop_hier)} 条,刷新 Member list")
            if not bok and berr.strip():
                log(f"  build 错误: {berr.strip().splitlines()[-1][:300]}")
            results.append({"step": "build", "exit": bcode, "seconds": bdur,
                            "summary": f"sop_hier {len(sop_hier)}; {bfirst[:160]}", "failed_nodes": 0,
                            "error": berr.strip().splitlines()[-1][:300] if not bok and berr.strip() else None})

    ok = all(r["exit"] == 0 for r in results)
    status = {"started_at": started, "finished_at": now(), "ok": ok, "steps": results}
    tmp = state_dir / "last-run.json.tmp"
    tmp.write_text(json.dumps(status, ensure_ascii=False, indent=1), encoding="utf-8")
    os.replace(tmp, state_dir / "last-run.json")
    if gate_file and ok:  # 全部成功才记下指纹;失败则下次触发还会重试。记的是运行前的指纹,运行期间的新变化不会被漏掉
        gtmp = gate_file.with_suffix(".tmp")
        gtmp.write_text(json.dumps({"fingerprint": gate_fp, "at": now()}), encoding="utf-8")
        os.replace(gtmp, gate_file)
    log("每日维护完成: " + ("全部成功" if ok else "有步骤失败,见上方"))
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
