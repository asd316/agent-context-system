# 摘要流水线使用的大模型,接口为 OpenAI 兼容格式 (如 DeepSeek)。
# 复制为 .env 后填写。.env 已被 .gitignore 排除,不要提交。

# 接口基础地址,通常以 /v1 结尾,例如 https://xxx.example.com/v1
OPENAI_BASE_URL=
# 访问密钥
OPENAI_API_KEY=
# 模型名,填接口里对应模型的名字
OPENAI_MODEL=

# 单次最多处理多少个节点。0 表示不限
SUMMARY_MAX_PER_RUN=0
# 并发请求数
SUMMARY_CONCURRENCY=8
# 单次请求超时(秒)
SUMMARY_TIMEOUT_SECONDS=60
